{
  "name": "sfeed",
  "private": true,
  "version": "1.0.0",
  "description": "Feedly-inspired Modern RSS Reader powered by React, Hono, Cloudflare D1 & Workers AI",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test:opml": "node scripts/verify-opml.mjs",
    "import:feedly": "node scripts/import-feedly-history.mjs",
    "preview": "vite preview",
    "cf:dev": "vite build && wrangler dev",
    "cf:deploy": "vite build && wrangler deploy",
    "db:migrate:local": "wrangler d1 execute sfeed --local --file=./migrations/0001_schema.sql",
    "db:migrate:remote": "wrangler d1 execute sfeed --remote --file=./migrations/0001_schema.sql",
    "test:feedly": "node --test scripts/verify-feedly-import.mjs",
    "import:feedly:sync": "node scripts/sync-feedly-history.mjs",
    "test:counts": "node scripts/verify-sidebar-counts.mjs",
    "test:real-feeds": "node scripts/verify-real-feeds.mjs",
    "test:dates": "node scripts/verify-publication-dates.mjs",
    "test:pwa": "node scripts/verify-pwa.mjs",
    "test:discovery": "node scripts/verify-discovery.mjs",
    "test:panels": "node scripts/verify-panel-widths.mjs",
    "test:builder": "node scripts/verify-rss-builder.mjs"
  },
  "dependencies": {
    "@cloudflare/puppeteer": "^1.4.0",
    "fast-xml-parser": "^5.0.8",
    "hono": "^4.7.2",
    "linkedom": "^0.18.14",
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250214.0",
    "@tailwindcss/vite": "^4.0.6",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.6",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "wrangler": "^3.109.0"
  }
}
